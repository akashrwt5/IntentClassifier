  },
  "grammar": {
    "time_format": "24h",
    "decimal_hour_idioms": [
      { "phrase": "et quart", "minutes": 15 },
      { "phrase": "et demie", "minutes": 30 },
      { "phrase": "et demi", "minutes": 30 },
      { "phrase": "moins le quart", "minutes": -15 },
      { "phrase": "moins quart", "minutes": -15 },
      { "phrase": "midi", "hour": 12, "minutes": 0 },
      { "phrase": "minuit", "hour": 0, "minutes": 0 },
      { "phrase": "midi et demi", "hour": 12, "minutes": 30 },
      { "phrase": "minuit et demi", "hour": 0, "minutes": 30 }
    ],
    "conjunction": "et",
    "notes": "Default 24h clock. Hour+minute is normally juxtaposed with no conjunction: '15h30', 'quinze heures trente'. The separator 'h' (or 'H') stands for 'heures' and may be spoken or written (9h, 9 h, 9 heures). 'moins le quart' subtracts 15 min from the NEXT hour (e.g. 'huit heures moins le quart' = 07:45). 'et demie' = :30, 'et quart' = :15. 'midi'=12:00, 'minuit'=00:00 and do not take an 'h' suffix. Bare numbers 1-12 may be 12h colloquially; rely on context / time-of-day words to disambiguate AM/PM."
  },
