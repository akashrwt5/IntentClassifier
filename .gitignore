__pycache__/
*.pyc
.DS_Store

# IDE / editor
.idea/
.vscode/

# Virtual environments
.venv*/
venv/
env/

# CoreML model bundles (regenerated locally, not committed)
*.mlpackage/

# Trained model artifacts (large binaries)
# Trained artifacts — regenerated by `make train`, shipped inside the pack.
# Recursive globs: models are now per-language at models/intent/<lang>/, and a
# single-level `models/*.onnx` would not have matched them.
models/**/*.onnx
models/**/*.pkl
models/**/*.npz
models/*.onnx
models/*.pkl

# macOS
__MACOSX/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Packaging / build
build/
dist/
*.egg-info/

# Pre-commit
.pre-commit-cache/

# Misc archives (regenerated)
*.zip
legacy_research/SemanticSupport/models/*.onnx

# Regenerable multilingual model artifacts (untracked 2026-07-14, ND-10):
# rebuild with `make train-multilingual`. Danish (da/) stays TRACKED as the
# exception — it currently fails the 0.80 accuracy gate and cannot be
# regenerated from a clean checkout (known-issues.md).
legacy_research/models/**
!legacy_research/models/da/
!legacy_research/models/da/**

# Local bundle build output (ADR-005 Part 13)
bundles/
# Leftover DVC state on machines that used it before 2026-07-26. `.dvc/cache/`
# holds a full content-addressed copy of every dataset, so without this a
# `git add -A` after pulling the DVC removal would commit the whole cache as a
# duplicate of datasets/. Keep it ignored; it is also your local backup.
.dvc/

# datasets/ is TRACKED IN GIT (was DVC-managed until 2026-07-26).
# ~6.7 MB of CSV across 29 files — small enough that git handles it directly,
# and DVC's local-path remote meant no other machine could ever fetch it.
# Generated model artifacts stay ignored; see models/ below.

# MLflow local file backend (roadmap §16)
mlruns/

# Local CI artifact staging (release-pack.yml downloads artifacts into dl/)
dl/

# Local virtualenvs beyond .venv*/venv/env/ (e.g. a hand-made test-venv/)
test-venv/
*-venv/

# Local scratch pipeline runners (never committed; regenerate as needed)
run_pipeline*.sh
