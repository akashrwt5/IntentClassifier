{
  "_meta": {
    "kind": "localization-overlay",
    "language": "fr",
    "localizes": "slot prompts, fulfillments, affirmative/negative/uncertain",
    "pending": "keyword_triggers and back_reference regexes are language-specific grammar, authored separately",
    "status": "draft-for-native-review"
  },
  "affirmative": [
    "yes",
    "ok",
    "okay",
    "oui",
    "ouais",
    "ouaip",
    "d'accord",
    "bien sûr",
    "envoie",
    "envoie-le",
    "confirme",
    "c'est correct",
    "c'est bon",
    "exact",
    "vas-y",
    "fais-le",
    "s'il te plaît"
  ],
  "confidence_threshold": 0.7,
  "help_marker_guard": {
    "markers": "(comment)|(\\bguide\\b)|(est-ce\\s+que)|(montre[z]?-moi.*(aide|guide))|(aide\\s+(pour|à\\s+comprendre))|(tutoriel)|(o[uù]\\s+puis-je)|(\\bexpliqu)|(à\\s+quoi\\s+sert)"
  },
  "negative": [
    "no",
    "non",
    "nan",
    "annule",
    "annuler",
    "arrête",
    "arrêter",
    "stop",
    "ne fais pas",
    "non merci",
    "laisse tomber",
    "oublie"
  ],
  "polarity_guards": [
    {
      "blocked_intent": "device.volume.unmute",
      "pattern": "coupe[rz]? le son|silence",
      "redirect_intent": "device.volume.mute"
    },
    {
      "blocked_intent": "device.volume.mute",
      "pattern": "r[ée]active[rz]? le son|remet(s|tre) le son",
      "redirect_intent": "device.volume.unmute"
    },
    {
      "blocked_intent": "device.volume.increase",
      "pattern": "moins fort|baisse|diminue|r[ée]duis|plus bas",
      "redirect_intent": "device.volume.decrease"
    },
    {
      "blocked_intent": "device.volume.decrease",
      "pattern": "plus fort|monte|augmente|plus haut",
      "redirect_intent": "device.volume.increase"
    },
    {
      "blocked_intent": "streaming.session.start",
      "pattern": "arr[êe]te|stoppe|termine|fin de",
      "redirect_intent": "streaming.session.stop"
    },
    {
      "blocked_intent": "streaming.session.stop",
      "pattern": "d[ée]marre|commence|lance",
      "redirect_intent": "streaming.session.start"
    }
  ],
  "uncertain_confirm": {
    "cancel_message": "D'accord, j'annule."
  },
  "version": 2,
