{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.intent-platform.local/bundle/3.0/cascade.schema.json",
  "title": "runtime/cascade.json — stage wiring + tensor contracts (ADR-005 Part 2)",
  "description": "Per-stage tensor contracts are asserted against actual model I/O at compile time (stage 8, probed via ORT) and defensively at model load on device.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stages"],
  "properties": {
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "enum": ["keyword", "tfidf", "semantic"] },
          "enabled": { "type": "boolean", "default": true },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dtype": { "type": "string", "enum": ["string", "int32", "int64", "float32"] },
              "shape": {
                "description": "Static shapes only — batch size 1 is a first-class on-device constraint.",
                "type": "array",
                "items": { "type": "integer", "minimum": 1 }
              },
              "max_len": { "type": "integer", "minimum": 1 }
            }
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dtype": { "type": "string", "enum": ["float32"] },
              "dim": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
