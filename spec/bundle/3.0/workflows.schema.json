{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.intent-platform.local/bundle/3.0/workflows.schema.json",
  "title": "capabilities/{id}/workflows.json — compiled intent micro-flows (ADR-005 Parts 2/4)",
  "description": "Facts, not behavior: slot lists, prompt references, validation instances bound to the closed predicate vocabulary, confirmation/completion wiring. Behavior kinds live in versioned runtimes (ADR-001.1 fact/behavior split).",
  "type": "object",
  "additionalProperties": false,
  "required": ["intents"],
  "properties": {
    "intents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9_. -]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completion"],
          "properties": {
            "status": { "type": "string", "enum": ["draft", "active", "deprecated"], "default": "active" },
            "superseded_by": { "$ref": "defs.schema.json#/$defs/intentId" },
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "entity", "prompt"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                  "entity": {
                    "description": "Capability-scoped or shared entity id (resolved by compiler stage 3).",
                    "$ref": "defs.schema.json#/$defs/stableId"
                  },
                  "required": { "type": "boolean", "default": true },
                  "prompt": { "$ref": "defs.schema.json#/$defs/responseKey" },
                  "reprompt": { "$ref": "defs.schema.json#/$defs/responseKey" },
                  "validation": {
                    "description": "Instances of the closed predicate set; parameters type-checked at compile time (stage 1/2).",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["predicate"],
                      "properties": {
                        "predicate": {
                          "type": "string",
                          "enum": ["in_range", "one_of", "matches", "not_past", "max_length"]
                        },
                        "params": { "type": "object" },
                        "failure_prompt": { "$ref": "defs.schema.json#/$defs/responseKey" }
                      }
                    }
                  }
                }
              }
            },
            "confirmation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "prompt"],
              "properties": {
                "required": { "type": "boolean" },
                "prompt": { "$ref": "defs.schema.json#/$defs/responseKey" },
                "high_cost": { "type": "boolean", "default": false }
              }
            },
            "completion": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "response"],
              "properties": {
                "action": {
                  "description": "Action key from this capability's capability.json (cross-capability references are a compile error — ADR-002 A9).",
                  "$ref": "defs.schema.json#/$defs/stableId"
                },
                "response": { "$ref": "defs.schema.json#/$defs/responseKey" }
              }
            },
            "followup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prompt", "on_yes"],
              "properties": {
                "prompt": { "$ref": "defs.schema.json#/$defs/responseKey" },
                "on_yes": { "$ref": "defs.schema.json#/$defs/intentId" },
                "on_no": { "$ref": "defs.schema.json#/$defs/responseKey" },
                "timeout_prompt": { "$ref": "defs.schema.json#/$defs/responseKey" }
              }
            },
            "back_reference": {
              "description": "Referent-table hook for corrections ('no, the other one').",
              "type": "object",
              "additionalProperties": false,
              "required": ["slot"],
              "properties": { "slot": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
