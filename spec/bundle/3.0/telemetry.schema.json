{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.intent-platform.local/bundle/3.0/telemetry.schema.json",
  "title": "telemetry/schema.json — event decoding contract (ADR-005 Part 2)",
  "description": "Closed enums so fleet analytics can decode any bundle's events without a code lookup. Additive evolution preferred.",
  "type": "object",
  "additionalProperties": false,
  "required": ["telemetry_schema_version", "enums"],
  "properties": {
    "telemetry_schema_version": { "type": "integer", "minimum": 1 },
    "enums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages", "routing_reason", "outcome", "lifecycle"],
      "properties": {
        "stages": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "defs.schema.json#/$defs/nonEmptyString" }
        },
        "routing_reason": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "defs.schema.json#/$defs/nonEmptyString" }
        },
        "outcome": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "defs.schema.json#/$defs/nonEmptyString" }
        },
        "lifecycle": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "defs.schema.json#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
