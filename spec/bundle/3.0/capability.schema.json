{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.intent-platform.local/bundle/3.0/capability.schema.json",
  "title": "capabilities/{id}/capability.json — compiled capability manifest (ADR-005 Part 4, ADR-002)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "platforms", "languages", "actions"],
  "properties": {
    "id": { "$ref": "defs.schema.json#/$defs/stableId" },
    "version": { "$ref": "defs.schema.json#/$defs/semverish" },
    "owner": {
      "description": "Owning team (diagnostics name the owning team — ADR-005 Part 5).",
      "type": "string"
    },
    "status": { "$ref": "defs.schema.json#/$defs/capabilityStatus" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["ios", "android", "server"] }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "defs.schema.json#/$defs/lang" }
    },
    "actions": {
      "description": "The action contract the SDK dispatches against. Codegen (stage 12) emits typed constants from exactly this.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "params", "descriptor"],
        "properties": {
          "key": { "$ref": "defs.schema.json#/$defs/stableId" },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "type": { "type": "string", "enum": ["string", "integer", "number", "boolean", "datetime", "entity_ref"] },
                "required": { "type": "boolean", "default": true },
                "entity": {
                  "description": "For type=entity_ref: the entity whose canonical values this param carries.",
                  "$ref": "defs.schema.json#/$defs/stableId"
                }
              }
            }
          },
          "descriptor": {
            "description": "Human-readable action description (also the tool-manifest export view, ADR-005 Part 12).",
            "$ref": "defs.schema.json#/$defs/nonEmptyString"
          },
          "high_cost": {
            "description": "High-cost actions stay confirmation-gated (charter medical-safety rule). Policy resolution (stage 5) must emit confirmation=required for intents completing with this action.",
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "availability": {
      "description": "Conditions under which the capability is available; recognized-but-unavailable routes to unavailable_response (ADR-002 A6 — intents are never removed from the label space).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition"],
            "properties": {
              "condition": { "$ref": "defs.schema.json#/$defs/stableId" },
              "params": { "type": "object" }
            }
          }
        },
        "unavailable_response": { "$ref": "defs.schema.json#/$defs/responseKey" }
      }
    },
    "flags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "superseded_by": { "$ref": "defs.schema.json#/$defs/stableId" }
  }
}
