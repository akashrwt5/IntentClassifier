{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.intent-platform.local/bundle/3.0/routing.schema.json",
  "title": "runtime/routing.json — escalation-ladder parameters (ADR-005 Part 2, ADR-004 §2)",
  "description": "GenAI escalation is narration-only: no path from a cloud response to the Action Dispatcher; egress is the current utterance only (ADR-004 — behavior enforced by the runtime; this table carries only parameters).",
  "type": "object",
  "additionalProperties": false,
  "required": ["ladder"],
  "properties": {
    "ladder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "when"],
        "properties": {
          "step": { "type": "string", "enum": ["reprompt", "semantic_rescue", "clarify", "assist_cloud", "give_up"] },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "below_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "after_attempts": { "type": "integer", "minimum": 1 },
              "requires_feature": { "$ref": "defs.schema.json#/$defs/runtimeFeature" },
              "requires_consent": { "type": "boolean" }
            }
          },
          "budget_per_session": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "assist_cloud": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "timeout_ms": { "type": "integer", "minimum": 100 },
        "routing_reasons": {
          "description": "Closed enum, must be a subset of telemetry/schema.json routing_reason values (stage 8).",
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      }
    }
  }
}
